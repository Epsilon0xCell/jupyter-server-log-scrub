 def _scrub_uri(uri: str, extra_param_keys=None) -> str:
     """scrub auth info from uri"""
 
-    scrub_param_keys = _DEFAULT_SCRUB_PARAM_KEYS.union(set(extra_param_keys or []))
+    scrub_param_keys = {
+        key.lower() for key in _DEFAULT_SCRUB_PARAM_KEYS.union(extra_param_keys or [])
+    }
 
     parsed = urlparse(uri)
     if parsed.query:
         # check for potentially sensitive url params
         # use manual list + split rather than parsing
         # to minimally perturb original
-        parts = parsed.query.split("&")
+        # split on both "&" and ";", keeping the separators,
+        # so the query is reassembled exactly as given
+        tokens = re.split(r"([&;])", parsed.query)
         changed = False
-        for i, s in enumerate(parts):
-            key, sep, _value = s.partition("=")
+        for i in range(0, len(tokens), 2):
+            key, sep, _value = tokens[i].partition("=")
+            # match against the decoded, lowercased key, so that
+            # case variants and percent-encoded keys are caught
+            decoded_key = unquote(key).lower()
             for substring in scrub_param_keys:
-                if substring in key:
-                    parts[i] = f"{key}{sep}[secret]"
+                if substring in decoded_key:
+                    tokens[i] = f"{key}{sep}[secret]"
                     changed = True
+                    break
         if changed:
-            parsed = parsed._replace(query="&".join(parts))
+            parsed = parsed._replace(query="".join(tokens))
             return urlunparse(parsed)
     return uri
 
