+# A stand-in secret value, assembled at runtime; the tests below
+# assert that it never survives _scrub_uri.
+SECRET_VALUE = "CAN" + "ARY" + "-VALUE-12345"
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        # case variants of the listed keys
+        "Token=",
+        "TOKEN=",
+        "Code=",
+        "State=",
+        "_XSRF=",
+        # a semicolon-separated parameter is its own parameter
+        "a=1;token=",
+        # percent-encoded key
+        "%74oken=",
+        # credential parameter covered by the default key list
+        "password=",
+    ],
+)
+def test_scrub_uri_scrubs_reported_shapes(query):
+    """Keys are matched after decoding and lowercasing, and on both separators."""
+    uri = f"http://example.com/path?{query}{SECRET_VALUE}"
+    assert SECRET_VALUE not in _scrub_uri(uri)
+
+
+def test_scrub_uri_leaves_benign_query_unchanged():
+    uri = "http://example.com/tree?normal=value&other=1"
+    assert _scrub_uri(uri) == uri
+
+
+def test_scrub_uri_preserves_separators_and_sibling_params():
+    uri = f"http://example.com/tree?a=1;token={SECRET_VALUE}"
+    out = _scrub_uri(uri)
+    assert SECRET_VALUE not in out
+    assert out.startswith("http://example.com/tree?a=1;token=")
+    assert "&" not in out
+
+
